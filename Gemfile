source "https://rubygems.org"

# Jekyll 4.x for modern GitHub Actions deployment
gem "jekyll", "~> 4.3.0"

# Required for Jekyll 4.x with Ruby 3+
gem "webrick"

# Plugins for remote theme and site functionality
group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-seo-tag"
  gem "jekyll-github-metadata"
  gem "jekyll-include-cache"
end
